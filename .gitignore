# Environment and credential files (never put live secrets in examples)
.env
.env.*
!.env.example
.credentials
.credentials.*
credentials.json
credentials.yaml
credentials.yml
.password
password.txt
.secrets
secrets.json
secrets.yaml
secrets.yml
.token
token.txt

# Private keys and containers. PEM may contain private keys: keep conservative.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.csr
*.srl

# Root-level local secret/runtime workspaces; phase documentation stays trackable.
/credentials/
/secrets/
/certs/
/pki/
/ca/
/generated/
/backups/
/logs/
/data/
/elasticsearch-data/
/kibana-data/

# Generated sensitive bundles and local exports
http-ca.zip
elastic-http.zip
elastic-root-ca.zip
elastic-stack-ca.zip
elastic-certificates.*
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.bak
*.backup
*.log

# Editors and temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
/tmp/
/temp/
.cache/

# Sanitized text examples only; these are not live PEM/env files.
!examples/**/*.pem.example
!examples/**/*.env.example
